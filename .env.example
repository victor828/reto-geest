# Puerto HTTP de la API
PORT=3500

# 'dev' o 'prod' — solo afecta el mensaje de arranque en consola
STAGE=dev

# Cadena de conexión PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reto_geest"

# URL externa a la que se notifica cuando una tarea se archiva (POST con {taskId, title, archivedAt})
NOTIFY_URL=http://localhost:4000/notify

# Backoff entre reintentos de notificación, en ms, separados por coma (máximo 3 intentos)
NOTIFICATION_BACKOFF_MS=200,500,1000

# Timeout por intento de notificación, en ms
NOTIFICATION_TIMEOUT_MS=5000

# Rate limiting (mejora extra, ver README): ventana en ms y máximo de requests por IP en esa ventana
THROTTLE_TTL_MS=10000
THROTTLE_LIMIT=30

# Título mostrado en Swagger (/api) — opcional
PROYECT_NAME="RETO GEEST — API de gestión de tareas"
